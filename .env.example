# Pocket ID (OIDC SSO)
POCKET_ID_URL=https://sso.brofrong.ru
POCKET_ID_CLIENT_SECRET=changeme
POCKET_ID_ADMIN_GROUP=cloud_gaming_admins

# Steam Web API
STEAM_API_KEY=changeme

# Better Auth
