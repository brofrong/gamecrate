# Публичный адрес приложения (baseURL Better Auth; его origin всегда разрешён для WebSocket /rpc)
PUBLIC_URL=https://game.brofrong.ru
# Необязательно: дополнительные Origin для WebSocket /rpc через запятую.
# Dev через apps/web/dev.ts (порт 5173) при PUBLIC_URL на другом origin:
ALLOWED_ORIGINS=http://localhost:5173

# Pocket ID (OIDC SSO)
POCKET_ID_URL=https://sso.brofrong.ru
POCKET_ID_CLIENT_ID=changeme
POCKET_ID_CLIENT_SECRET=changeme
POCKET_ID_ADMIN_GROUP=cloud_gaming_admins

# Steam Web API
STEAM_API_KEY=changeme

# Better Auth
BETTER_AUTH_SECRET=changeme

# Почта (письма с кодом входа и т.п.)
# Для прода — настоящий SMTP (например smtps://user:pass@smtp.example:465); log:// пишет письма
# в лог вместо отправки и разрешён только когда PUBLIC_URL — localhost/127.0.0.1.
SMTP_URL=log://
MAIL_FROM=GameCrate <no-reply@brofrong.ru>

# Провайдеры входа (необязательно): не заданы или заданы пустой строкой — вход через них выключен.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Витрины партнёров (необязательно): `хост=бренд` через запятую, бренды — packages/brands.
# Хосты вне списка — основной бренд GameCrate. В dev `<бренд>.localhost` (например
# http://beeline.localhost:5173/) показывает витрину без настройки; чтобы на нём работали
# вход и /rpc, добавьте origin в ALLOWED_ORIGINS
# (ALLOWED_ORIGINS=http://localhost:5173,http://beeline.localhost:5173). Новая витрина целиком:
# раздел «Новая витрина» в deploy/README.md.
# BRAND_HOSTS=play.beeline.ru=beeline
# Хосты (через запятую, без порта), на которых включён вход через провайдера: redirect URI
# должен быть зарегистрирован у провайдера для каждого. Не задано — только хост PUBLIC_URL.
# OAUTH_HOSTS_GOOGLE=
# OAUTH_HOSTS_YANDEX=
# OAUTH_HOSTS_POCKET_ID=
# OAUTH_HOSTS_TELEGRAM=

# PostgreSQL (локально — deploy/compose.dev.yaml)
DATABASE_URL=postgres://cg:cg@127.0.0.1:5442/cloud_gaming
# Служебная БД для тестов: на ней создаются временные базы cg_test_*
TEST_DATABASE_URL=postgres://cg:cg@127.0.0.1:5442/postgres

# HTTP-сервер
PORT=3000
# Куда ходит прокси стрима (/stream/<id>/…) вместо сети cg-sessions — relay оркестратора
# (ANY /relay/<id>/…, см. RELAY_PORT ниже). По умолчанию http://cg-orchestrator:3002.
# ORCHESTRATOR_RELAY_URL=http://cg-orchestrator:3002
# Общий секрет api и relay оркестратора (не короче 32 символов, один и тот же у обоих): api шлёт
# его в заголовке x-cg-relay-secret, relay без него отвечает 403. Сгенерировать: openssl rand -hex 32
RELAY_SECRET=
# Папка собранной SPA (bun run build → apps/web/dist); путь относительно apps/api
WEB_DIST_DIR=../web/dist
# Каталог своих игр (games/<slug>/game.json); не задан — games/ в корне репозитория
# OWN_GAMES_DIR=

# Оркестратор (apps/orchestrator). Агенты входят токеном своего сервера (выдаёт админка
# кодом подключения, POST /agent/enroll); общего AGENT_TOKEN у оркестратора больше нет.
ORCHESTRATOR_PORT=3001
# Публичный адрес главного, только origin без пути: из него агент получает адрес WebSocket
# (https → wss://…/agent).
ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:3001
# Внутренний порт тоннеля стрима для api (наружу не публикуется). По умолчанию 3002.
# RELAY_PORT=3002
# Версия релиза (тег образов), которую ставят новые серверы. По умолчанию dev (зашита в образ;
# на главном сервере CG_VERSION=<тег> в .env — это и тег образа в deploy/compose.main.yaml).
# CG_VERSION=dev
# Реестр образов для агентов (только чтение): все три или ни одной.
REGISTRY_SERVER=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# S3 профилей, как его видят игровые серверы (GET /agent/config): адрес плюс S3_BUCKET,
# S3_ACCESS_KEY, S3_SECRET_KEY и PROFILE_KEY (ниже, в блоке RustFS) — их читает только
# оркестратор и отдаёт агентам своим ответом; в окружении агента их больше нет.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# Ключ шифрования посеянных входов Steam в БД (steam_login_seeds, AES-256-GCM): base64 ровно
# 32 байт, иначе оркестратор не стартует. Сгенерировать: openssl rand -base64 32
SEED_KEY=

# Агент воркера (apps/agent). WORKER_TOKEN — постоянный токен этого сервера (выдаёт
# POST /agent/enroll обменом одноразового кода подключения, см. админку); на старте агент
# ставит его в Authorization: Bearer и получает конфиг хранилища (S3/PROFILE_KEY) с главного
# (GET /agent/config) — в окружении агента их больше нет. На игровом сервере всё это пишет в
# /opt/cloud-gaming/.env скрипт установки (deploy/worker/install.sh, ORCHESTRATOR_URL=wss://…/agent),
# на стенде brofrong ORCHESTRATOR_URL=ws://cg-orchestrator:3001/agent и пути задаёт
# deploy/compose.stand.yaml (см. deploy/README.md).
WORKER_ID=brofrong
WORKER_TOKEN=
ORCHESTRATOR_URL=ws://127.0.0.1:3001/agent
WORKER_PUBLIC_IP=37.153.14.138
SESSION_IMAGE=cg-session:550.163.01
# Версия сборки агента (деплой ставит тег релиза), видна в админке. По умолчанию dev.
# CG_VERSION=dev
# Необязательно (значения по умолчанию): SLOTS=1, UDP_PORT_BASE=59000,
# SESSION_NETWORK=cg-sessions, DOCKER_SOCKET=/var/run/docker.sock
# Debian: GBM-бэкенд NVIDIA пробрасывается в контейнеры сессий
GBM_ALLOCATOR_PATH=/usr/lib/x86_64-linux-gnu/nvidia/current/libnvidia-allocator.so.550.163.01
# Роли агента через запятую: worker — сессии, gamestore — установка игр в общую библиотеку
# (на сервере по умолчанию worker,gamestore).
ROLES=worker,gamestore
# Каталоги хоста (владелец uid 1000). На сервере compose задаёт LIBRARY_DIR, INSTALL_SCRATCH_DIR и
# GAMES_DIR внутри CG_DATA_DIR (игровой сервер — /srv/cloud-gaming, стенд — /raid/cloud-gaming:
# одна точка монтирования, перенос игр `rename`), SCRATCH_DIR (scratch сессий:
# /srv/cloud-gaming-scratch, стенд — /home/brofrong/cloud-gaming-scratch) и STEAM_CLIENT_DIR
# (шаблон клиента Steam на NVMe: /srv/cloud-gaming-steam/client, стенд —
# /home/brofrong/cloud-gaming-steam/client); в серверном .env — CG_DATA_DIR, SCRATCH_DIR,
# STEAM_CLIENT_DIR и STEAM_CLIENT_PARENT, без кавычек.
LIBRARY_DIR=/raid/cloud-gaming/library
STEAM_CLIENT_DIR=/home/brofrong/cloud-gaming-steam/client
INSTALL_SCRATCH_DIR=/raid/cloud-gaming/install-scratch
SCRATCH_DIR=/home/brofrong/cloud-gaming-scratch
# Сеть контейнеров сессий cg-sessions на сервере: фиксированная подсеть, ip-range для контейнеров
# сессий и закреплённый вне него адрес cg-agent (правило изоляции :8080 привязано к нему).
# По умолчанию (deploy/compose.worker.yaml, install.sh, deploy-stand.sh):
# CG_SESSIONS_SUBNET=172.31.240.0/24, CG_SESSIONS_IP_RANGE=172.31.240.128/25, CG_AGENT_IP=172.31.240.2
# Минимум свободного места (ГиБ) на ФС SCRATCH_DIR / INSTALL_SCRATCH_DIR: меньше — запуск сессии и
# установка отклоняются («На сервере закончилось место»). По умолчанию 20.
MIN_FREE_GB=20

# Хранилище профилей RustFS (S3). Ключи RustFS — не короче 16 символов, они же S3_ACCESS_KEY и
# S3_SECRET_KEY оркестратора (на сервере compose подставляет их сам). Сгенерировать:
# openssl rand -hex 24
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY и PROFILE_KEY читает только оркестратор (не агент —
# он получает их его ответом GET /agent/config, см. выше S3_PUBLIC_ENDPOINT).
S3_BUCKET=cg-profiles
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Раздача десктоп-приложения (страница «Скачать», /download/desktop/*): бакет cg-desktop в том же
# RustFS. cg-api раздаёт файлы и принимает их выкладку из GitHub Actions, ключу нужны чтение и
# запись cg-desktop/*. В compose.main.yaml пустые DESKTOP_S3_* = корневые RUSTFS_*; можно задать
# отдельного пользователя RustFS только на cg-desktop/*. Без ключей вовсе (dev без RustFS) API
# работает, а /download/desktop/* отвечает 404 («Скоро»).
# Бакет создаётся один раз: docker compose -f compose.main.yaml --env-file .env run --rm -e BUCKET=cg-desktop cg-rustfs-bucket
DESKTOP_S3_ENDPOINT=http://cg-rustfs:9000
DESKTOP_S3_BUCKET=cg-desktop
DESKTOP_S3_ACCESS_KEY=
DESKTOP_S3_SECRET_KEY=
# Токен выкладки сборок: джоб publish (.github/workflows/desktop.yml) шлёт
# PUT /download/desktop/... с Authorization: Bearer <токен>. Тот же токен — секрет GitHub
# DESKTOP_UPLOAD_TOKEN. Пусто — выкладка выключена (PUT → 404). Сгенерировать: openssl rand -hex 32
DESKTOP_UPLOAD_TOKEN=
# Ключ шифрования профилей: base64 ровно 32 байт; никогда не выводить.
# Сгенерировать: openssl rand -base64 32. Потеря ключа = потеря всех сохранённых профилей.
PROFILE_KEY=
