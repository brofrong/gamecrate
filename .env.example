# Публичный адрес приложения (baseURL Better Auth; его origin всегда разрешён для WebSocket /rpc)
PUBLIC_URL=https://game.brofrong.ru
# Необязательно: дополнительные Origin для WebSocket /rpc через запятую.
# Dev через apps/web/dev.ts (порт 5173) при PUBLIC_URL на другом origin:
ALLOWED_ORIGINS=http://localhost:5173

# Pocket ID (OIDC SSO)
POCKET_ID_URL=https://sso.brofrong.ru
POCKET_ID_CLIENT_ID=changeme
POCKET_ID_CLIENT_SECRET=changeme
POCKET_ID_ADMIN_GROUP=cloud_gaming_admins

# Steam Web API
STEAM_API_KEY=changeme

# Better Auth
BETTER_AUTH_SECRET=changeme

# Почта (письма с кодом входа и т.п.)
# Для прода — настоящий SMTP (например smtps://user:pass@smtp.example:465); log:// пишет письма
# в лог вместо отправки и разрешён только когда PUBLIC_URL — localhost/127.0.0.1.
SMTP_URL=log://
MAIL_FROM=GameCrate <no-reply@brofrong.ru>

# Провайдеры входа (необязательно): не заданы или заданы пустой строкой — вход через них выключен.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# PostgreSQL (локально — deploy/compose.dev.yaml)
DATABASE_URL=postgres://cg:cg@127.0.0.1:5442/cloud_gaming
# Служебная БД для тестов: на ней создаются временные базы cg_test_*
TEST_DATABASE_URL=postgres://cg:cg@127.0.0.1:5442/postgres

# HTTP-сервер
PORT=3000
# Папка собранной SPA (bun run build → apps/web/dist); путь относительно apps/api
WEB_DIST_DIR=../web/dist

# Оркестратор (apps/orchestrator)
ORCHESTRATOR_PORT=3001
# Общий секрет агентов воркеров: Authorization: Bearer <AGENT_TOKEN> на GET /agent.
# Не короче 32 символов, иначе оркестратор не стартует. Сгенерировать: openssl rand -hex 32
AGENT_TOKEN=
# Ключ шифрования посеянных входов Steam в БД (steam_login_seeds, AES-256-GCM): base64 ровно
# 32 байт, иначе оркестратор не стартует. Сгенерировать: openssl rand -base64 32
SEED_KEY=

# Агент воркера (apps/agent); AGENT_TOKEN — тот же, что у оркестратора.
# На сервере (deploy/compose.yaml) ORCHESTRATOR_URL=ws://cg-orchestrator:3001/agent задаёт compose,
# остальные значения ниже — значения по умолчанию в compose (переопределяются в серверном .env,
# например SESSION_IMAGE и GBM_ALLOCATOR_PATH после обновления драйвера, см. deploy/README.md).
WORKER_ID=brofrong
ORCHESTRATOR_URL=ws://127.0.0.1:3001/agent
WORKER_PUBLIC_IP=37.153.14.138
SESSION_IMAGE=cg-session:550.163.01
# Необязательно (значения по умолчанию): SLOTS=1, UDP_PORT_BASE=59000,
# SESSION_NETWORK=cg-sessions, DOCKER_SOCKET=/var/run/docker.sock
# Debian: GBM-бэкенд NVIDIA пробрасывается в контейнеры сессий
GBM_ALLOCATOR_PATH=/usr/lib/x86_64-linux-gnu/nvidia/current/libnvidia-allocator.so.550.163.01
# Роли агента через запятую: worker — сессии, gamestore — установка игр в общую библиотеку
# (на сервере по умолчанию worker,gamestore).
ROLES=worker,gamestore
# Каталоги хоста (владелец uid 1000). На сервере compose задаёт LIBRARY_DIR и INSTALL_SCRATCH_DIR
# внутри CG_DATA_DIR (по умолчанию /raid/cloud-gaming: library, install-scratch — одна точка
# монтирования, перенос игр `rename`), SCRATCH_DIR (scratch сессий, по умолчанию
# /home/brofrong/cloud-gaming-scratch) и STEAM_CLIENT_DIR (шаблон клиента Steam на NVMe, по
# умолчанию /home/brofrong/cloud-gaming-steam/client); в серверном .env переопределяются только
# CG_DATA_DIR, SCRATCH_DIR и STEAM_CLIENT_DIR, без кавычек.
LIBRARY_DIR=/raid/cloud-gaming/library
STEAM_CLIENT_DIR=/home/brofrong/cloud-gaming-steam/client
INSTALL_SCRATCH_DIR=/raid/cloud-gaming/install-scratch
SCRATCH_DIR=/home/brofrong/cloud-gaming-scratch
# Минимум свободного места (ГиБ) на ФС SCRATCH_DIR / INSTALL_SCRATCH_DIR: меньше — запуск сессии и
# установка отклоняются («На сервере закончилось место»). По умолчанию 20.
MIN_FREE_GB=20

# Хранилище профилей RustFS (S3). Ключи RustFS — не короче 16 символов, они же S3_ACCESS_KEY и
# S3_SECRET_KEY агента (на сервере compose подставляет их сам). Сгенерировать: openssl rand -hex 24
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Агент локально (на сервере: S3_ENDPOINT=http://cg-rustfs:9000 задаёт compose).
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=cg-profiles
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Ключ шифрования профилей: base64 ровно 32 байт. Видит только агент; никогда не выводить.
# Сгенерировать: openssl rand -base64 32. Потеря ключа = потеря всех сохранённых профилей.
PROFILE_KEY=
