{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameCrate",
  "identifier": "ru.brofrong.gamecrate",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Облачный гейминг GameCrate",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "gamecrate"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MDE0RERGNDFEQzQzNjgKUldSb1E5eEIzMDBCV0toSFVqaEd5UTNINzJSckpmQnFOOHp2QzZTTGZVais3cExQcTdMVTdwczcK"
    }
  }
}
