#!/usr/bin/env python3
# Заглушка org.freedesktop.NetworkManager на системной шине контейнера: «сеть есть» —
# одно активное ethernet-устройство eth0, активное соединение, полная связность.
#
# Зачем: Steam (libnm из steam-runtime) перед входом ждёт от NetworkManager активное устройство.
# Службы NetworkManager в контейнере нет, и каждый запуск Steam ждал таймаута ровно 20 с
# («[ WaitingForNetwork ] Timed out waiting for network»). С этой заглушкой ожидание — 0 с
# (замер: docs/superpowers/specs/2026-10-26-faster-session-start-design.md, «Ожидание сети»).
# Одних State/Connectivity мало: без устройства Steam ждёт так же 20 с.
#
# Ничего не меняет в сети контейнера: только отвечает на вопросы. Сети правда нет — Steam
# узнает об этом при входе, а не через таймаут. Запускает служба s6 cg-nm-stub от ubuntu; владеть
# именем на шине разрешает /etc/dbus-1/system.d/cg-nm-stub.conf.
import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

DBusGMainLoop(set_as_default=True)
bus = dbus.SystemBus()
name = dbus.service.BusName("org.freedesktop.NetworkManager", bus, do_not_queue=True)

NM = "org.freedesktop.NetworkManager"
OBJ = "/org/freedesktop/NetworkManager"
NONE = dbus.ObjectPath("/")
DEV = dbus.ObjectPath(OBJ + "/Devices/1")
AC = dbus.ObjectPath(OBJ + "/ActiveConnection/1")
IP4 = dbus.ObjectPath(OBJ + "/IP4Config/1")
CONN = dbus.ObjectPath(OBJ + "/Settings/1")
NO_PATHS = dbus.Array([], signature="o")

# NM_STATE_CONNECTED_GLOBAL, NM_CONNECTIVITY_FULL.
STATE = dbus.UInt32(70)
CONNECTIVITY = dbus.UInt32(4)
MANAGER = {
    "State": STATE,
    "Connectivity": CONNECTIVITY,
    "NetworkingEnabled": True,
    "WirelessEnabled": False,
    "WirelessHardwareEnabled": False,
    "WwanEnabled": False,
    "WwanHardwareEnabled": False,
    "Version": "1.42.4",
    "Devices": dbus.Array([DEV], signature="o"),
    "AllDevices": dbus.Array([DEV], signature="o"),
    "ActiveConnections": dbus.Array([AC], signature="o"),
    "Checkpoints": NO_PATHS,
    "Capabilities": dbus.Array([], signature="u"),
    "PrimaryConnection": AC,
    "ActivatingConnection": NONE,
    "PrimaryConnectionType": "802-3-ethernet",
    "Startup": False,
    "Metered": dbus.UInt32(4),
    "ConnectivityCheckAvailable": True,
    "ConnectivityCheckEnabled": True,
    "ConnectivityCheckUri": "",
    "GlobalDnsConfiguration": dbus.Dictionary({}, signature="sv"),
}
SETTINGS = {"Connections": dbus.Array([CONN], signature="o"), "Hostname": "cg", "CanModify": False}
HW_ADDRESS = "02:42:AC:11:00:02"
# NM_DEVICE_STATE_ACTIVATED, тип NM_DEVICE_TYPE_ETHERNET.
DEVICE = {
    "Udi": "/sys/devices/virtual/net/eth0",
    "Path": "",
    "Interface": "eth0",
    "IpInterface": "eth0",
    "Driver": "veth",
    "DriverVersion": "1.0",
    "FirmwareVersion": "",
    "Capabilities": dbus.UInt32(3),
    "State": dbus.UInt32(100),
    "StateReason": dbus.Struct((dbus.UInt32(100), dbus.UInt32(0)), signature="uu"),
    "ActiveConnection": AC,
    "Ip4Config": IP4,
    "Dhcp4Config": NONE,
    "Ip6Config": NONE,
    "Dhcp6Config": NONE,
    "Managed": True,
    "Autoconnect": True,
    "FirmwareMissing": False,
    "NmPluginMissing": False,
    "DeviceType": dbus.UInt32(1),
    "AvailableConnections": dbus.Array([CONN], signature="o"),
    "PhysicalPortId": "",
    "Mtu": dbus.UInt32(1500),
    "Metered": dbus.UInt32(4),
    "LldpNeighbors": dbus.Array([], signature="a{sv}"),
    "Real": True,
    "Ip4Connectivity": CONNECTIVITY,
    "Ip6Connectivity": dbus.UInt32(1),
    "InterfaceFlags": dbus.UInt32(0x10003),
    "HwAddress": HW_ADDRESS,
    "Ports": NO_PATHS,
}
WIRED = {
    "HwAddress": HW_ADDRESS,
    "PermHwAddress": HW_ADDRESS,
    "Speed": dbus.UInt32(1000),
    "S390Subchannels": dbus.Array([], signature="s"),
    "Carrier": True,
}
# NM_ACTIVE_CONNECTION_STATE_ACTIVATED.
ACTIVE = {
    "Connection": CONN,
    "SpecificObject": NONE,
    "Id": "Wired connection 1",
    "Uuid": "6f0f3c5e-0000-4000-8000-000000000001",
    "Type": "802-3-ethernet",
    "Devices": dbus.Array([DEV], signature="o"),
    "State": dbus.UInt32(2),
    "StateFlags": dbus.UInt32(0),
    "Default": True,
    "Ip4Config": IP4,
    "Dhcp4Config": NONE,
    "Default6": False,
    "Ip6Config": NONE,
    "Dhcp6Config": NONE,
    "Vpn": False,
    "Controller": NONE,
    "Master": NONE,
}
IP4_CONFIG = {
    "AddressData": dbus.Array(
        [dbus.Dictionary({"address": "172.17.0.2", "prefix": dbus.UInt32(16)}, signature="sv")],
        signature="a{sv}",
    ),
    "Gateway": "172.17.0.1",
    "RouteData": dbus.Array([], signature="a{sv}"),
    "NameserverData": dbus.Array([], signature="a{sv}"),
    "Domains": dbus.Array([], signature="s"),
    "Searches": dbus.Array([], signature="s"),
    "DnsOptions": dbus.Array([], signature="s"),
    "DnsPriority": 100,
    "WinsServerData": dbus.Array([], signature="s"),
}
CONNECTION = {"Unsaved": False, "Flags": dbus.UInt32(0), "Filename": ""}


class Root(dbus.service.Object):
    """libnm берёт все объекты разом через ObjectManager."""

    @dbus.service.method("org.freedesktop.DBus.ObjectManager", out_signature="a{oa{sa{sv}}}")
    def GetManagedObjects(self):
        return {
            dbus.ObjectPath(OBJ): {NM: MANAGER},
            dbus.ObjectPath(OBJ + "/Settings"): {NM + ".Settings": SETTINGS},
            DEV: {NM + ".Device": DEVICE, NM + ".Device.Wired": WIRED},
            AC: {NM + ".Connection.Active": ACTIVE},
            IP4: {NM + ".IP4Config": IP4_CONFIG},
            CONN: {NM + ".Settings.Connection": CONNECTION},
        }


class Props(dbus.service.Object):
    """Объект со свойствами по интерфейсам (`Get`/`GetAll`)."""

    def __init__(self, path, props_by_iface):
        super().__init__(bus, path)
        self.props_by_iface = props_by_iface

    @dbus.service.method("org.freedesktop.DBus.Properties", in_signature="ss", out_signature="v")
    def Get(self, iface, prop):
        return self.props_by_iface[iface][prop]

    @dbus.service.method("org.freedesktop.DBus.Properties", in_signature="s", out_signature="a{sv}")
    def GetAll(self, iface):
        return self.props_by_iface.get(iface, dbus.Dictionary({}, signature="sv"))

    @dbus.service.signal("org.freedesktop.DBus.Properties", signature="sa{sv}as")
    def PropertiesChanged(self, iface, changed, invalidated):
        pass


class Manager(Props):
    @dbus.service.signal(NM, signature="u")
    def StateChanged(self, state):
        pass

    @dbus.service.method(NM, out_signature="u")
    def state(self):
        return STATE

    @dbus.service.method(NM, out_signature="u")
    def CheckConnectivity(self):
        return CONNECTIVITY

    @dbus.service.method(NM, out_signature="ao")
    def GetDevices(self):
        return MANAGER["Devices"]

    @dbus.service.method(NM, out_signature="ao")
    def GetAllDevices(self):
        return MANAGER["AllDevices"]

    @dbus.service.method(NM, out_signature="a{ss}")
    def GetPermissions(self):
        return dbus.Dictionary({}, signature="ss")


class Device(Props):
    @dbus.service.signal(NM + ".Device", signature="uuu")
    def StateChanged(self, new, old, reason):
        pass


Root(bus, "/org/freedesktop")
manager = Manager(OBJ, {NM: MANAGER})
Props(OBJ + "/Settings", {NM + ".Settings": SETTINGS})
device = Device(DEV, {NM + ".Device": DEVICE, NM + ".Device.Wired": WIRED})
Props(AC, {NM + ".Connection.Active": ACTIVE})
Props(IP4, {NM + ".IP4Config": IP4_CONFIG})
Props(CONN, {NM + ".Settings.Connection": CONNECTION})


def announce():
    """Сигналы состояния раз в 2 с, как в замере: клиенту, подключившемуся позже, тоже."""
    manager.StateChanged(STATE)
    manager.PropertiesChanged(
        NM,
        dbus.Dictionary({"State": STATE, "Connectivity": CONNECTIVITY}, signature="sv"),
        dbus.Array([], signature="s"),
    )
    device.StateChanged(DEVICE["State"], DEVICE["State"], dbus.UInt32(0))
    return True


GLib.timeout_add_seconds(2, announce)
print("[cg-nm-stub] org.freedesktop.NetworkManager: connected (eth0)", flush=True)
GLib.MainLoop().run()
