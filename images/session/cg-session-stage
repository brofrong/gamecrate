#!/bin/bash
# Этап запуска игры в сессии. Печатает одно слово и выходит с 0:
#   $1 — число (appid)  — Steam-игра: steam | login | prepare | loading | visible
#   $1 = --own          — своя игра (план «свои игры»): computer | loading | visible
# $1 не число и не --own — exit 2. Агент зовёт `docker exec <container> cg-session-stage <appid>`
# (или `cg-session-stage --own`) раз в 2 с (план «экран загрузки», §4.1) и показывает этап на сайте.
#
# Без root и без KDE-сессии (ни plasmashell, ни KWin/qdbus — нужно работать и на композиторе без
# рабочего стола, план 4): окружение X11 для xdotool берём из /proc/<pid клиента Steam>/environ
# (своя игра — из /proc/<pid обёртки cg-game-exit>/environ), как cg-steam-shutdown берёт его из
# /proc/<plasmashell>/environ.
#
# Steam-игра — проверки от последнего этапа к первому, первое совпадение и есть ответ:
#   visible  — у reaper с AppId=<appid> есть видимое окно ≥ 64×64: класс steam_app_<appid>
#              (так Proton называет окно игры) или окно потомка reaper (нативная игра, у неё
#              свой класс);
#   loading  — есть процесс, чья командная строка начинается с «<буква>:\common\»: так Proton
#              запускает exe игры (например, S:\common\1966900\Game.exe). Служебные exe самого
#              Proton (\\?\S:\common\Proton…) и Windows (C:\windows\…) так не начинаются;
#   prepare  — Steam запустил игру: есть reaper с AppId=<appid>, а exe игры ещё не стартовал;
#   login    — в логе клиента есть хоть одна строка SetLoginState (вход начался или прошёл);
#   steam    — иначе: контейнер и клиент Steam только стартуют.
#
# `AppId=<appid>` собирается внутри скрипта из $1: свой argv (и значит, свою командную строку,
# которую тоже видит pgrep -f) скрипт никогда не содержит буквально, иначе рисковал бы совпасть
# с проверкой агента `pgrep -f "AppId=<id>( |$)"` (SessionSupervisor.ts).
#
# Своя игра — без Steam и reaper, запускается `cg-launch` через обёртку `cg-game-exit`
# (`exec /usr/local/bin/cg-game-exit "${CG_GAME}"`, CG_GAME = /opt/cg-game/run, только для чтения):
#   visible  — у потомка обёртки есть видимое окно ≥ 64×64 (игра — прямой потомок обёртки: `run`
#              делает `exec`); класса steam_app_<appid> у своих игр нет, поэтому поиск только по
#              потомкам;
#   loading  — обёртка жива, окна ещё нет;
#   computer — иначе: обёртки нет (контейнер только стартует).
# Шаблон обёртки, как AppId=<appid> выше, собирается внутри скрипта (как reaper_pattern), чтобы
# argv скрипта (`--own`) с ним не совпал буквально.
#
# CG_STAGE_PROC — другой корень вместо /proc (тесты). HOME — из окружения (его задаёт агент/тест).
#
# Агент опрашивает скрипт раз в 2 с — зависший или не отвечающий X11 (`xdotool`/`xwininfo`) не
# должен подвесить опрос: каждый такой вызов обёрнут в `timeout` (coreutils, есть в образе);
# истёк срок — окно считаем не найденным, а не ждём и не падаем.
set -u

proc_root="${CG_STAGE_PROC:-/proc}"
x11_timeout_sec=1

# Все потомки pid, не только прямые дети: окно игры может принадлежать процессу через несколько
# уровней (reaper → Steam Linux Runtime → … → Proton/Wine; для своей игры — обёртка → run → игра).
descendants() {
  local parent="$1" children child
  children=$(pgrep -P "${parent}" 2>/dev/null) || return 0
  for child in ${children}; do
    printf '%s\n' "${child}"
    descendants "${child}"
  done
}

# DISPLAY/XAUTHORITY графической сессии: берём из окружения клиента Steam или обёртки своей игры,
# другого способа без KDE нет.
load_x11_env() {
  local pid="$1" var
  while IFS= read -r -d '' var; do
    case "${var}" in
      DISPLAY=* | XAUTHORITY=*) export "${var?}" ;;
    esac
  done <"${proc_root}/${pid}/environ"
}

# Width:/Height: из `xwininfo -id <win>` (строки с отступом). Нет такого окна — xwininfo падает.
window_big_enough() {
  local win="$1" info width height
  info=$(timeout "${x11_timeout_sec}" xwininfo -id "${win}" 2>/dev/null) || return 1
  width=$(printf '%s\n' "${info}" | sed -n 's/^ *Width: *//p')
  height=$(printf '%s\n' "${info}" | sed -n 's/^ *Height: *//p')
  [ -n "${width}" ] && [ -n "${height}" ] && [ "${width}" -ge 64 ] && [ "${height}" -ge 64 ]
}

# Окружение X11 процесса pid — до любого вызова xdotool/xwininfo: у `docker exec` нет DISPLAY,
# без него каждый поиск окна пуст. Нет процесса или не прочитать его окружение — 1, проверку окон
# пропускаем.
use_x11_env_of() {
  local pid="$1"
  [ -n "${pid}" ] && [ -r "${proc_root}/${pid}/environ" ] || return 1
  load_x11_env "${pid}"
}

# Видимое окно ≥ 64×64 у любого потомка tree_pid (Steam — reaper, своя игра — обёртка). Окружение
# X11 уже загружено (use_x11_env_of).
descendant_window_visible() {
  local tree_pid="$1"
  [ -n "${tree_pid}" ] || return 1

  local descendant win
  for descendant in $(descendants "${tree_pid}"); do
    for win in $(timeout "${x11_timeout_sec}" xdotool search --onlyvisible --pid \
      "${descendant}" 2>/dev/null); do
      window_big_enough "${win}" && return 0
    done
  done
  return 1
}

if [ "${1:-}" = "--own" ]; then
  wrapper_pattern='cg-game-exit /opt/cg-game/run( |$)'
  wrapper_pid=$(pgrep -f "${wrapper_pattern}" | head -1)

  if use_x11_env_of "${wrapper_pid}" && descendant_window_visible "${wrapper_pid}"; then
    echo visible
    exit 0
  fi
  if [ -n "${wrapper_pid}" ]; then
    echo loading
    exit 0
  fi
  echo computer
  exit 0
fi

app_id="${1:-}"
case "${app_id}" in
  '' | *[!0-9]*)
    echo "[cg-session-stage] appid is not a number: ${app_id}" >&2
    exit 2
    ;;
esac

# Шаблон reaper — как gamePattern в SessionSupervisor.ts: якорь `( |$)`, чтобы AppId=10 не
# совпадал с AppId=105.
reaper_pattern="AppId=${app_id}( |\$)"
reaper_pid=$(pgrep -f "${reaper_pattern}" | head -1)

# Клиент Steam — как в cg-steam-shutdown (не steam-runtime, не steamwebhelper).
client_pid() { pgrep -f 'ubuntu12_32/steam( |$)' | head -1; }

is_visible() {
  [ -n "${reaper_pid}" ] || return 1
  # Окружение клиента Steam — до поиска по классу, иначе xdotool без DISPLAY ничего не найдёт.
  use_x11_env_of "$(client_pid)" || return 1

  local win
  for win in $(timeout "${x11_timeout_sec}" xdotool search --onlyvisible --class \
    "^steam_app_${app_id}\$" 2>/dev/null); do
    window_big_enough "${win}" && return 0
  done

  descendant_window_visible "${reaper_pid}"
}

is_loading() {
  pgrep -f '^[A-Za-z]:\\common\\' >/dev/null 2>&1
}

is_login() {
  local log="${HOME}/.local/share/Steam/logs/steamui_login.txt"
  [ -r "${log}" ] && grep -q 'SetLoginState' "${log}"
}

if is_visible; then
  echo visible
  exit 0
fi
if is_loading; then
  echo loading
  exit 0
fi
if [ -n "${reaper_pid}" ]; then
  echo prepare
  exit 0
fi
if is_login; then
  echo login
  exit 0
fi
echo steam
exit 0
