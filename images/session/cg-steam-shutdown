#!/bin/bash
# Штатно закрыть клиент Steam перед снятием профиля (агент: `docker exec`): `steam -shutdown`
# в окружении процесса сессии (его находит cg-session-exec) и ожидание выхода клиента до 30 с.
# Клиент не запущен — сразу 0. Не вышел за 30 с — 1 (агент только предупреждает в логе и всё
# равно снимает профиль).
#
# `docker exec` идёт без окружения сессии: без DISPLAY/XAUTHORITY Steam падает с «Unable to open
# X11 display», поэтому переменные берёт cg-session-exec из /proc/<pid клиента>/environ.
set -u

timeout_sec=30

# Процесс клиента: …/ubuntu12_32/steam (не steam-runtime, не steamwebhelper). pgrep не находит сам
# себя, а командная строка этого скрипта шаблона не содержит.
client_running() { pgrep -f 'ubuntu12_32/steam( |$)' >/dev/null; }

if ! client_running; then
  exit 0
fi

# В фоне и без наших stdout/stderr: `docker exec` иначе ждал бы закрытия потоков.
cg-session-exec steam -shutdown </dev/null >/dev/null 2>&1 &

for ((i = 0; i < timeout_sec; i++)); do
  client_running || exit 0
  sleep 1
done
echo "[cg-steam-shutdown] Steam did not exit in ${timeout_sec} s" >&2
exit 1
