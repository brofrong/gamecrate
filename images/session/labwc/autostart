#!/bin/sh
# Автостарт сессии labwc → /etc/xdg/labwc/autostart. labwc читает его на старте сессии, если в
# профиле игрока нет своего (~/.config/labwc/autostart) — у нас его нет никогда. Служба
# /etc/service/wayland базового образа запускает labwc напрямую, без systemd user и без KDE, так
# что /etc/xdg/autostart/*.desktop здесь никто не обрабатывает. Дети автостарта получают окружение
# сессии labwc: LD_PRELOAD интерпозера ввода Selkies (иначе Steam не видит геймпад), DISPLAY
# Xwayland и WAYLAND_DISPLAY вложенной сессии (wayland-0).
#
# Сессионную шину D-Bus в этой базе никто не поднимает (служба dbus — только системная, её видит
# cg-nm-stub), а Steam и cg-steam-shutdown её ищут. Поднимаем её по фиксированному адресу
# ${XDG_RUNTIME_DIR}/bus: в /proc/<labwc>/environ её не будет (экспорт отсюда видят только дети
# автостарта), и cg-session-exec, взяв окружение у labwc (Steam не запущен — например, второй цикл
# build-steam-client.sh), ставит этот же адрес. Если labwc перезапустился и шина жива — та же.
runtime_dir="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
bus_address="unix:path=${runtime_dir}/bus"
if ! dbus-send --bus="${bus_address}" --dest=org.freedesktop.DBus --print-reply \
  /org/freedesktop/DBus org.freedesktop.DBus.GetId >/dev/null 2>&1; then
  rm -f "${runtime_dir}/bus"
  dbus-daemon --session --fork --address="${bus_address}"
fi
DBUS_SESSION_BUS_ADDRESS="${bus_address}"
export DBUS_SESSION_BUS_ADDRESS

/usr/local/bin/cg-launch &
