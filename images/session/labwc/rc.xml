<?xml version="1.0"?>
<!--
  Конфиг сессионного композитора labwc образа-киоска → /etc/xdg/labwc/rc.xml (заменяет штатный
  файл базового образа Selkies целиком). Не в ~/.config: туда смотрит профиль игрока
  (cg-profile-pack пакует весь .config), а системный путь (/etc/xdg, часть XDG_CONFIG_DIRS) labwc
  читает, когда в профиле своего rc.xml нет, то есть всегда для этого образа.

  Цель — только окно игры/Steam: без рамок, без меню, без горячих клавиш композитора.
-->
<labwc_config>
  <core>
    <!-- Никакого зазора между окном и краем экрана. -->
    <gap>0</gap>
  </core>

  <!-- Пустые <keyboard>/<mouse> НЕ годятся: labwc 0.9.7 пишет «Empty string is not allowed for
       keyboard/mouse. Ignoring» и, раз привязок нет, грузит встроенные (Alt+F4, Alt+Tab, меню по
       клику на фоне с «Exit»…). Поэтому — одна безвредная привязка клавиши (которой нет на
       клавиатурах) и только фокус по клику в окне: встроенные тогда не загружаются (проверено
       владельцем в браузере на пробе: Alt+F4, Alt+Tab, правый клик по фону ничего не делают). -->
  <keyboard>
    <keybind key="XF86Launch9">
      <action name="Execute" command="true" />
    </keybind>
  </keyboard>

  <mouse>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
  </mouse>

  <!-- Каждое окно — без декораций, во весь экран, не в «панели задач» (её и так нет).
       ignoreConfigureRequest — приложение не может само выйти из полноэкранного режима сменой
       геометрии. Окно фиксированного размера (вход в Steam, 700x440, min = max) labwc во весь
       экран не растягивает: оно стоит без рамки на чёрном фоне. -->
  <windowRules>
    <windowRule identifier="*"
                serverDecoration="no"
                skipTaskbar="yes"
                fullscreenForced="yes"
                ignoreConfigureRequest="yes">
    </windowRule>
  </windowRules>
</labwc_config>
