<?xml version="1.0"?>
<!--
  Конфиг сессионного композитора labwc образа-киоска → /etc/xdg/labwc/rc.xml (заменяет штатный
  файл базового образа Selkies целиком). Не в ~/.config: туда смотрит профиль игрока
  (cg-profile-pack пакует весь .config), а системный путь (/etc/xdg, часть XDG_CONFIG_DIRS) labwc
  читает, когда в профиле своего rc.xml нет, то есть всегда для этого образа.

  Цель — только окно игры/Steam: без рамок, без меню, без горячих клавиш композитора.
-->
<labwc_config>
  <core>
    <!-- Никакого зазора между окном и краем экрана. -->
    <gap>0</gap>
  </core>

  <!-- Пустые <keyboard>/<mouse> НЕ годятся: labwc 0.9.7 пишет «Empty string is not allowed for
       keyboard/mouse. Ignoring» и, раз привязок нет, грузит встроенные (Alt+F4, Alt+Tab, меню по
       клику на фоне с «Exit»…). Поэтому — одна безвредная привязка клавиши (которой нет на
       клавиатурах) и только фокус по клику в окне: встроенные тогда не загружаются (проверено
       владельцем в браузере на пробе: Alt+F4, Alt+Tab, правый клик по фону ничего не делают). -->
  <keyboard>
    <keybind key="XF86Launch9">
      <action name="Execute" command="true" />
    </keybind>
  </keyboard>

  <mouse>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
  </mouse>

  <!-- Свойства (labwc 0.9.7, labwc-config(5) «WINDOW RULES»): у каждого окна — без декораций
       композитора, не в «панели задач» (её и так нет). Свойства «во весь экран» у labwc нет
       (атрибут fullscreenForced он молча пропускает), а ignoreConfigureRequest не нужен:
       развёрнутому окну labwc сам не даёт менять геометрию (на запрос отвечает своей).

       Действие при первом показе окна: развернуть на весь экран 1920x1080 (gap 0, рамок нет).
       Maximize, а не ToggleFullscreen: окно, которое уже само попросилось во весь экран (игры),
       labwc не трогает, а Toggle вернул бы его обратно. Не разворачиваются окна служебных типов
       (_NET_WM_WINDOW_TYPE: диалоги, меню, подсказки…) — это If ниже; окна без типа (xev,
       многие игры) считаются обычными. Override-redirect окна (выпадающие меню Steam) labwc не
       управляет вовсе. Окно входа Steam (NORMAL, min = max 700x440) тоже разворачивается — Steam
       растягивает его разметку (проверено на brofrong). -->
  <windowRules>
    <windowRule identifier="*" serverDecoration="no" skipTaskbar="yes" />
    <windowRule identifier="*">
      <action name="If">
        <query type="dialog" />
        <query type="utility" />
        <query type="splash" />
        <query type="toolbar" />
        <query type="menu" />
        <query type="dropdown_menu" />
        <query type="popup_menu" />
        <query type="tooltip" />
        <query type="notification" />
        <query type="combo" />
        <query type="dnd" />
        <query type="dock" />
        <query type="desktop" />
        <else>
          <action name="Maximize" />
        </else>
      </action>
    </windowRule>
  </windowRules>
</labwc_config>
