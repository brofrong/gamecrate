<?xml version="1.0"?>
<!--
  Проба (план 4, задача 2, throwaway) — не прод.

  Конфиг сессионного композитора labwc для образа-киоска: заменяет штатный
  /etc/xdg/labwc/rc.xml базового образа Selkies целиком. Кладётся в /etc/xdg/labwc/, НЕ в
  ~/.config — последнее уходит в профиль игрока (cg-profile-pack пакует весь .config), а
  системный путь (/etc/xdg, часть XDG_CONFIG_DIRS) labwc читает только когда в профиле своего
  rc.xml нет, то есть всегда для этого образа. Подтверждено пробой (шаг 1): штатный
  /etc/xdg/labwc/rc.xml базы несёт собственный комментарий «which labwc reads when the user has
  no rc.xml of their own».

  labwc moделирует поведение Openbox (так в комментарии штатного rc.xml) — секция конфига,
  присутствующая в файле хотя бы пустой, заменяет встроенные умолчания целиком, а не дополняет
  их. Поэтому пустые <keyboard> и <mouse> ниже — это и есть «без горячих клавиш выхода/смены
  рабочего стола и без меню по правому клику», а не отсутствие проверки: сочетания клавиш и клик
  по фону ничего не делают, потому что не привязаны ни к одному действию.

  ЭТО НЕ ПОДТВЕРЖДЕНО ЖИВЫМ ЗАПУСКОМ (шаг 3 плана — GPU-контейнер — вне объёма этой задачи).
  Атрибуты windowRule (serverDecoration, skipTaskbar, fullscreenForced, ignoreConfigureRequest)
  найдены как имена полей в бинарнике labwc (`strings /usr/bin/labwc`), точный синтаксис и
  работоспособность — проверить в шаге 3.
-->
<labwc_config>
  <core>
    <!-- Никакого зазора между окном и краем экрана. -->
    <gap>0</gap>
  </core>

  <!-- Пусто: ни одного сочетания клавиш (никакого Alt+F4/Alt+Tab/Super+... выхода или смены
       рабочего стола). -->
  <keyboard>
  </keyboard>

  <!-- Пусто: клик по фону (в т.ч. правой кнопкой) ничего не открывает — нет меню.xml и нет
       привязки ShowMenu. -->
  <mouse>
  </mouse>

  <!-- Каждое окно — без декораций (ни своей, ни от композитора), во весь экран, не в «панели
       задач» (которой и так нет). ignoreConfigureRequest — чтобы приложение/Steam не могло
       само выйти из полноэкранного режима изменением своей геометрии. -->
  <windowRules>
    <windowRule identifier="*"
                serverDecoration="no"
                skipTaskbar="yes"
                fullscreenForced="yes"
                ignoreConfigureRequest="yes">
    </windowRule>
  </windowRules>
</labwc_config>
