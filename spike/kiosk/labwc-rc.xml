<?xml version="1.0"?>
<!--
  Проба (план 4, задача 2, throwaway) — не прод.

  Конфиг сессионного композитора labwc для образа-киоска: заменяет штатный
  /etc/xdg/labwc/rc.xml базового образа Selkies целиком. Кладётся в /etc/xdg/labwc/, НЕ в
  ~/.config — последнее уходит в профиль игрока (cg-profile-pack пакует весь .config), а
  системный путь (/etc/xdg, часть XDG_CONFIG_DIRS) labwc читает только когда в профиле своего
  rc.xml нет, то есть всегда для этого образа. Подтверждено пробой (шаг 1): штатный
  /etc/xdg/labwc/rc.xml базы несёт собственный комментарий «which labwc reads when the user has
  no rc.xml of their own».

  Шаг 3 (живой запуск на brofrong, labwc 0.9.7): пустые <keyboard>/<mouse> labwc отвергает и
  грузит встроенные привязки, поэтому ниже — минимальные непустые секции (см. комментарий там).
  windowRule ниже распознан (ошибок разбора нет), но окно входа Steam (min=max 700x440) во весь
  экран не растянуто — fullscreenForced на окно фиксированного размера не действует.
-->
<labwc_config>
  <core>
    <!-- Никакого зазора между окном и краем экрана. -->
    <gap>0</gap>
  </core>

  <!-- Шаг 3 (живой запуск): ПУСТЫЕ <keyboard>/<mouse> НЕ работают — labwc 0.9.7 пишет
       «Empty string is not allowed for keyboard/mouse. Ignoring» и, раз привязок нет, грузит
       встроенные умолчания («load default key/mouse bindings»: Alt+F4, Alt+Tab, меню по клику
       на фоне с «Exit»…). Поэтому — одна безвредная привязка клавиши (кнопка, которой нет на
       клавиатурах) и только фокус по клику в окне: этого достаточно, чтобы умолчания не
       загрузились. -->
  <keyboard>
    <keybind key="XF86Launch9">
      <action name="Execute" command="true" />
    </keybind>
  </keyboard>

  <mouse>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
  </mouse>

  <!-- Каждое окно — без декораций (ни своей, ни от композитора), во весь экран, не в «панели
       задач» (которой и так нет). ignoreConfigureRequest — чтобы приложение/Steam не могло
       само выйти из полноэкранного режима изменением своей геометрии. -->
  <windowRules>
    <windowRule identifier="*"
                serverDecoration="no"
                skipTaskbar="yes"
                fullscreenForced="yes"
                ignoreConfigureRequest="yes">
    </windowRule>
  </windowRules>
</labwc_config>
